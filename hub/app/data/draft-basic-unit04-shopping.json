  "grammarCards": [
    {
      "id": "isseoyo-opseoyo",
      "kind": "contrast",
      "title": {
        "en": "있어요 ↔ 없어요",
        "ko": "있어요 ↔ 없어요",
        "zh": "있어요 ↔ 없어요"
      },
      "body": {
        "en": "세종·국어원 pair: 있어요 = exists / is present / available / have. 없어요 = not. Same stem job, opposite polarity — stock (사이즈 있어요?), location, and belongings. Not the same as 이에요/예요 (naming “X is Y”).",
        "ko": "세종·국어원 짝: 있어요=있다/있음·가능·소유. 없어요=없다. 같은 역할, 반대 극성 — 재고·위치·소지. 이에요/예요(「X는 Y이다」 정체)와 다름.",
        "zh": "世宗/国语院成对：있어요=有/在/可买到；없어요=没有。同一职责、相反极性——库存、位置、所有。不同于이에요/예요（指认“X是Y”）。"
      },
      "examples": [
        {
          "ko": "사이즈 있어요?",
          "gloss": {
            "en": "Stock / available · 있어요",
            "ko": "재고·가능 · 있어요",
            "zh": "有库存 · 있어요"
          }
        },
        {
          "ko": "카드 없어요.",
          "gloss": {
            "en": "Don’t have · 없어요",
            "ko": "없음 · 없어요",
            "zh": "没有 · 없어요"
          }
        },
        {
          "ko": "이거 있어요?",
          "gloss": {
            "en": "Point + ask availability",
            "ko": "가리킴+있어요?",
            "zh": "指着问有没有"
          }
        }
      ],
      "trap": {
        "en": "있어요 ≠ 이에요. “Is this a bag?” → 가방이에요? · “Do you have a bag?” → 가방 있어요?",
        "ko": "있어요 ≠ 이에요. 「가방이에요?」=정체 · 「가방 있어요?」=있음/재고.",
        "zh": "있어요 ≠ 이에요。问“是不是包”用이에요；问“有没有包”用있어요。"
      },
      "related": [
        {
          "href": "../../blog/#isseoyo-vs-opseoyo",
          "label": {
            "en": "글모음 · 있어요 vs 없어요 →",
            "ko": "글모음 · 있어요 vs 없어요 →",
            "zh": "글모음 · 있어요 vs 없어요 →"
          }
        }
      ]
    },
    {
      "id": "doeyo",
      "title": {
        "en": "… 봐도 돼요?",
        "ko": "… 봐도 돼요?",
        "zh": "… 봐도 돼요？"
      },
      "body": {
        "en": "V-아/어 봐도 돼요? ≈ May I try …? Soft permission — common in shops (입어 봐도 돼요?).",
        "ko": "V-아/어 봐도 돼요?=해도 될까요? 매장에서 자주.",
        "zh": "…봐도 돼요？≈可以试试吗？"
      },
      "examples": [
        {
          "ko": "입어 봐도 돼요?",
          "gloss": {
            "en": "May I try it on?",
            "ko": "입어 봐도 될까요?",
            "zh": "可以试穿吗？"
          }
        },
        {
          "ko": "이거 얼마예요?",
          "gloss": {
            "en": "Point + price",
            "ko": "가리킴+가격",
            "zh": "这个多少钱"
          }
        }
      ],
      "trap": {
        "en": "Permission ask ≠ stock ask. 입어 봐도 돼요? (may I) · 사이즈 있어요? (do you have).",
        "ko": "허가 ≠ 재고. 입어 봐도 돼요?(해도 될까) · 사이즈 있어요?(있나).",
        "zh": "许可≠库存。봐도 돼요？=可以吗；있어요？=有没有。"
      }
    }
  ]
